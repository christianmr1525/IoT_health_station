# =============================================================================
# IoT Health & Environment Station v2.0 - Environment Configuration Template
# Copy to .env before running Docker Compose or the backend directly.
# =============================================================================

# --- HTTP Web Dashboard (localhost-only by default) ---
HEALTH_BIND_HOST=127.0.0.1
HEALTH_PORT=8095
HEALTH_DB_PATH=data/health_station.db
ALERT_COOLDOWN_SEC=60
LOG_LEVEL=INFO

# --- MQTT Broker (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERTS=

# --- Simulator ---
SIM_INTERVAL_SEC=2.0
